#!/bin/sh

# Pre-commit validation
# - Run tests
# - Run linter
# - Type check
# - Check for secrets

set -e

echo "🔍 Pre-commit validation starting..."

# 1. Run tests
echo "  Running tests..."
npm test 2>/dev/null || {
  echo "  ❌ Tests failed"
  exit 1
}
echo "  ✅ Tests passed"

# 2. Run linter
echo "  Running linter..."
npm run lint --silent 2>/dev/null || {
  echo "  ❌ Linter errors found"
  exit 1
}
echo "  ✅ Linter passed"

# 3. Type check
echo "  Type checking..."
npm run type-check --silent 2>/dev/null || {
  echo "  ❌ Type errors found"
  exit 1
}
echo "  ✅ Type check passed"

# 4. Check for secrets (look for actual secret values, not env var names in config files)
echo "  Checking for secrets..."
if git diff --cached -- ':(exclude)*.example' ':(exclude)*.md' | grep -qE "(GITHUB_TOKEN|API_KEY|NEXTAUTH_SECRET|JWT_SECRET)\s*=\s*['\"]?[A-Za-z0-9+/]{20,}['\"]?"; then
  echo "  ❌ Potential secrets detected"
  exit 1
fi
echo "  ✅ No secrets found"

echo "✅ Pre-commit validation passed"
exit 0
