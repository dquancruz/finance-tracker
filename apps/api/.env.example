MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/finance-tracker?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-random-32-char-string
GOOGLE_CLIENT_ID=your-google-client-id
PORT=3001
NODE_ENV=development

# Comma-separated list of allowed origins for CORS. In production this MUST
# be set to the real frontend origin(s) — no wildcard fallback is used
# outside of NODE_ENV=development.
CORS_ORIGIN=http://localhost:3000

# Global rate limiting (requests per window) — applies to every route
# unless overridden with @Throttle()/@SkipThrottle() on a controller/handler.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Optional bootstrap admin — created or promoted on API startup when both are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Admin
